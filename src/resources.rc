#pragma code_page(65001)
#include "resource.h"
#include <windows.h>

IDR_RU_DAWG     RCDATA "data/ru_dawg.bin"
IDR_EN_DAWG     RCDATA "data/en_dawg.bin"
IDR_RU_TRIGRAMS RCDATA "data/ru_trigrams.bin"
IDR_EN_TRIGRAMS RCDATA "data/en_trigrams.bin"
IDR_TYPO_RULES  RCDATA "data/typo_rules.bin"

IDI_APP_ICON_ON  ICON "res/app_on.ico"
IDI_APP_ICON_OFF ICON "res/app_off.ico"

// Manifest
1 24 "app.manifest"

// Version Information
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Ultimakey Project"
            VALUE "FileDescription",  "Ultimakey - Fast Keyboard Layout Switcher"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "Ultimakey"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Ultimakey Team"
            VALUE "OriginalFilename", "Ultimakey.exe"
            VALUE "ProductName",      "Ultimakey"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

